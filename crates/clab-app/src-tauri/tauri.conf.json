{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChassisLab",
  "version": "0.7.0",
  "identifier": "com.github.jensolschewski.chassislab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ChassisLab", "width": 900, "height": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
