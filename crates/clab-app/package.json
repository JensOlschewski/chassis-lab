{
  "name": "clab-app",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "bundle:linux": "tauri build --config src-tauri/tauri.runtime-linux.conf.json --bundles deb",
    "bundle:windows": "tauri build --config src-tauri/tauri.runtime-windows.conf.json --bundles nsis",
    "bundle:macos": "tauri build --config src-tauri/tauri.runtime-macos.conf.json --bundles app,dmg"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "plotly.js-basic-dist-min": "^4.1.2"
  }
}
